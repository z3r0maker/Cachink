{
  "name": "@xangarro/email",
  "version": "0.0.0",
  "private": true,
  "description": "Transactional email (B-14): Spanish React Email templates and the EmailSender adapters (Resend, dev outbox). Server-only; the port lives in @xangarro/application/email.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --config ../../eslint.config.js",
    "lint:fix": "eslint . --config ../../eslint.config.js --fix",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@xangarro/application": "workspace:*",
    "@xangarro/tokens": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@xangarro/config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
