{
  "name": "@cachink/data",
  "version": "0.0.0",
  "private": true,
  "description": "Repository interfaces and Drizzle/SQLite implementations. Pure types; no UI.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./repositories": "./src/repositories/index.ts",
    "./schema": "./src/schema/index.ts",
    "./hardware": "./src/hardware/index.ts",
    "./migrations": "./drizzle/migrations/index.ts",
    "./migrator": "./src/migrator/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' 'drizzle/**/*.ts' --config ../../eslint.config.js",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' 'drizzle/**/*.ts' --config ../../eslint.config.js --fix",
    "db:generate": "drizzle-kit generate && tsx scripts/gen-migration-barrel.ts",
    "db:new": "tsx scripts/new-migration.ts",
    "db:barrel": "tsx scripts/gen-migration-barrel.ts",
    "db:check": "drizzle-kit check",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@cachink/domain": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cachink/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/coverage-v8": "^4.1.6",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
