{
  "name": "@xangarro/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Shared testing utilities, fixtures, and in-memory repository implementations.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract/index.ts",
    "./ui": "./src/ui/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --config ../../eslint.config.js",
    "lint:fix": "eslint . --config ../../eslint.config.js --fix",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@xangarro/data": "workspace:*",
    "@xangarro/domain": "workspace:*",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "react": "^19",
    "@xangarro/ui": "workspace:*"
  },
  "devDependencies": {
    "@xangarro/config": "workspace:*",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.6",
    "react": "^19",
    "typescript": "^6.0.3",
    "@xangarro/ui": "workspace:*"
  }
}
