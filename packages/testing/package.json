{
  "name": "@xangarro/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Shared testing utilities, fixtures, and in-memory repository implementations.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract/index.ts",
    "./ui": "./src/ui/index.ts",
    "./integration": "./src/integration.ts",
    "./corp": "./src/corp/cfdi.ts",
    "./server-actions": "./src/server-actions.ts",
    "./tenant": "./src/tenant/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tenant.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --config ../../eslint.config.js",
    "lint:fix": "eslint . --config ../../eslint.config.js --fix",
    "clean": "rm -rf dist .turbo",
    "test:db": "REQUIRE_DB=1 DATABASE_URL=${DATABASE_URL:-$(../data-pg/scripts/db-local.sh url)} DATABASE_SUPER_URL=${DATABASE_SUPER_URL:-$(../data-pg/scripts/db-local.sh super-url)} BILLING_DATABASE_URL=${BILLING_DATABASE_URL:-$(../data-pg/scripts/db-local.sh billing-url)} vitest run .integration.test"
  },
  "dependencies": {
    "@xangarro/auth-core": "workspace:*",
    "@xangarro/contracts": "workspace:*",
    "@xangarro/data": "workspace:*",
    "@xangarro/domain": "workspace:*",
    "postgres": "^3.4.9",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@xangarro/ui": "workspace:*",
    "react": "^19"
  },
  "devDependencies": {
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.6",
    "@xangarro/config": "workspace:*",
    "@xangarro/sync": "workspace:*",
    "@xangarro/ui": "workspace:*",
    "react": "^19",
    "typescript": "^6.0.3"
  }
}
