{
  "name": "@xangarro/guias",
  "version": "0.0.0",
  "private": true,
  "description": "What Xangarro teaches: Don Cuentas's guides, the quick answers and the search over them (ADR-163). Zero runtime dependencies so every surface can read it.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --config ../../eslint.config.js",
    "lint:fix": "eslint . --config ../../eslint.config.js --fix",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@xangarro/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
