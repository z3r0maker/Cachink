{
  "name": "@xangarro/data-pg",
  "version": "0.0.0",
  "private": true,
  "description": "Postgres (Drizzle pg-core) schema for the cloud database, plus the drift test that keeps it aligned with the device's SQLite schema.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --config ../../eslint.config.js",
    "lint:fix": "eslint . --config ../../eslint.config.js --fix",
    "clean": "rm -rf dist .turbo",
    "db:generate": "drizzle-kit generate",
    "db:up": "./scripts/db-local.sh up",
    "db:down": "./scripts/db-local.sh down",
    "test:db": "DATABASE_URL=$(./scripts/db-local.sh url) vitest run",
    "db:seed": "DATABASE_URL=$(./scripts/db-local.sh url) tsx ./scripts/seed.ts"
  },
  "dependencies": {
    "@xangarro/contracts": "workspace:*",
    "@xangarro/domain": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@xangarro/config": "workspace:*",
    "@xangarro/data": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "tsx": "^4.23.13"
  }
}
