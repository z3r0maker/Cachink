{
  "name": "@xangarro/application",
  "version": "0.0.0",
  "private": true,
  "description": "Use-cases. Orchestrates domain + repositories. No UI, no direct DB access.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cfdi": "./src/cfdi/index.ts",
    "./billing": "./src/billing/index.ts",
    "./email": "./src/email/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --config ../../eslint.config.js",
    "lint:fix": "eslint . --config ../../eslint.config.js --fix",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@xangarro/contracts": "workspace:*",
    "@xangarro/data": "workspace:*",
    "@xangarro/domain": "workspace:*",
    "bcryptjs": "3.0.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@xangarro/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
