{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../config/tsconfig.lib.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": ["node_modules", "dist", "tests"],
  "references": [
    {
      "path": "../domain"
    }
  ]
}
