{
  "name": "@xangarro/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "API + wire contracts shared by the phone and the cloud (zod). See docs/plan/02-contracts.md. No transport, no crypto, no IO.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./mock": "./src/mock/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --config ../../eslint.config.js",
    "lint:fix": "eslint . --config ../../eslint.config.js --fix",
    "clean": "rm -rf dist .turbo",
    "mock:api": "tsx src/mock/cli.ts",
    "test:conformance": "vitest run tests/conformance"
  },
  "dependencies": {
    "@xangarro/domain": "workspace:*",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@noble/ed25519": "3.2.0",
    "@types/node": "^22.19.17",
    "@vitest/coverage-v8": "^4.1.6",
    "@xangarro/config": "workspace:*",
    "bcryptjs": "3.0.3",
    "msw": "2.15.0",
    "tsx": "4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
