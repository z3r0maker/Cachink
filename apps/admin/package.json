{
  "name": "@xangarro/admin",
  "version": "0.0.0",
  "private": true,
  "description": "Xangarro! internal staff console at admin.xangarro.mx (ADR-063). Next.js App Router, vanilla-extract over @xangarro/tokens (ADR-057). The only project that may hold the Supabase service-role key.",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3200",
    "build": "NODE_ENV=production next build --webpack",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --config ../../eslint.config.js && tsx scripts/guard-service-role.ts",
    "lint:fix": "eslint . --config ../../eslint.config.js --fix",
    "clean": "rm -rf .next dist .turbo"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vanilla-extract/css": "^1.21.2",
    "@xangarro/data-pg": "workspace:*",
    "@xangarro/domain": "workspace:*",
    "@xangarro/tokens": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "@xangarro/config": "workspace:*",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
