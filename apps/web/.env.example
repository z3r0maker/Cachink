# Xangarro portal (app.xangarro.mx) — every environment variable it reads.
#
# Copy to .env.local for local work (gitignored), or set each one in the
# portal's Vercel project (Settings → Environment Variables). Values stay
# EMPTY here; never commit a real one. Runbook: docs/ops/provisioning.md.
# `scripts/env-example.test.ts` fails CI when this file and the code drift.
#
# No Supabase API key is used: every connection is a Postgres login role of
# its own, provisioned by `pnpm --filter @xangarro/data-pg db:migrate:hosted`.
# Hosted URLs use the Supabase *Transaction pooler* (port 6543, user
# `<role>.jijggmddzacwcldwnmzj`, `?sslmode=require`).

# --- Database -----------------------------------------------------------------
# Tenant requests, RLS-bound. Role: xangarro_app.
DATABASE_URL=
# Stripe webhook and billing actions, cross-tenant billing tables. Role: xangarro_billing.
BILLING_DATABASE_URL=
# Nightly usage recompute (/api/cron/usage). Role: xangarro_metering.
METERING_DATABASE_URL=

# --- Device credentials (contract §2, §6) -------------------------------------
# HS256 key for device tokens. Generate with: openssl rand -base64 32
DEVICE_TOKEN_SECRET=
# Ed25519 private key, 64 hex. Generate with: pnpm --filter @xangarro/web entitlement:keygen
ENTITLEMENT_PRIVATE_KEY=

# --- Public origin ------------------------------------------------------------
# Links in emails and Stripe return URLs, e.g. https://app.xangarro.mx (falls back to the request origin).
PORTAL_URL=

# --- Crons (vercel.json) ------------------------------------------------------
# Vercel sends it as `Authorization: Bearer …`; unset closes every cron route. Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Billing: Stripe, TEST MODE ONLY (B-10) -----------------------------------
# sk_test_… or rk_test_…; a live key is refused.
STRIPE_SECRET_KEY=
# whsec_… of the endpoint https://app.xangarro.mx/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# pk_test_…, shown to the Suscripción screen only.
STRIPE_PUBLISHABLE_KEY=
# 1 = the beta charges nobody (P-36 D-1): no Checkout opens, the paid CTAs show the «pronto» notice. Unset at launch.
BILLING_BETA_NO_CHARGE=

# --- CFDI of Xangarro's own subscription invoices (ADR-070) -------------------
# off | test | live (default off: nothing is stamped).
CFDI_MODE=
# Facturapi organization secret key: sk_test_… for CFDI_MODE=test, sk_live_… for live.
FACTURAPI_API_KEY=
# Optional; default https://www.facturapi.io/v2.
FACTURAPI_BASE_URL=
# Issuer's 5-digit código postal (LugarExpedicion); required unless CFDI_MODE=off.
CFDI_LUGAR_EXPEDICION=
# Optional ClaveProdServ, default 81112106.
CFDI_PRODUCT_KEY=
# Optional ClaveUnidad, default E48.
CFDI_UNIT_KEY=

# --- Email: Resend (B-14, docs/ops/email.md) ----------------------------------
# Sending-only key for xangarro.mx. Unset on Vercel → sends are refused and reported; unset locally → .email-outbox/.
RESEND_API_KEY=
# Optional; default `Xangarro <hola@xangarro.mx>`.
EMAIL_FROM=
# Optional, e.g. soporte@xangarro.mx.
EMAIL_REPLY_TO=

# --- Admin console support inbox ----------------------------------------------
# https://admin.xangarro.mx/api/internal/support-items
ADMIN_INGEST_URL=
# Same value as the admin project's ADMIN_INGEST_SECRET. Generate with: openssl rand -base64 32
ADMIN_INGEST_SECRET=

# --- Observability ------------------------------------------------------------
# Sentry DSN; unset sends nothing.
SENTRY_DSN=

# --- Asesor LLM (P-30, apps/web/src/server/asesor/model.ts) -------------------
# Unset = recorded fixtures (CI, fresh clones, production before the credential) and the ADR-059 «Próximamente» gate stays closed.
# Gateway the Anthropic SDK points at: http://localhost:3456 (cliproxyapi) locally, the Azure AI Foundry endpoint in Vercel.
ASESOR_LLM_BASE_URL=
# Key of that gateway (cliproxyapi config locally, the Foundry credential in Vercel).
ASESOR_LLM_API_KEY=
# Optional model id override, e.g. claude-opus-4-6 while the gateway has not caught up with ADR-056's claude-opus-5.
ASESOR_LLM_MODEL=

# --- Coverage (ADR-102, scripts/coverage-gate) -----------------------------------
# Set by `pnpm test:e2e:coverage` and CI's coverage build: source maps, page coverage, inspector.
XG_COVERAGE=
# Inspector port of the coverage server; defaults to 9331.
XG_INSPECT_PORT=
