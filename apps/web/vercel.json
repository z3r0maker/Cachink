{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter '@xangarro/web...' --workspace-concurrency=1 run build",
  "git": { "deploymentEnabled": false },
  "crons": [
    { "path": "/api/cron/trial-emails", "schedule": "0 15 * * *" },
    { "path": "/api/cron/renewal-emails", "schedule": "0 16 * * *" },
    { "path": "/api/cron/borrar-cuentas", "schedule": "0 10 * * *" },
    { "path": "/api/cron/purgar-fotos", "schedule": "0 11 * * *" },
    { "path": "/api/cron/asesor", "schedule": "0 8 * * *" },
    { "path": "/api/cron/usage", "schedule": "0 9 * * *" },
    { "path": "/api/cron/cfdi-close", "schedule": "0 7 1 * *" }
  ]
}
