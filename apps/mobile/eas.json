{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/packages/eas-json/schema/eas.schema.json",
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SENTRY_DSN": "$PREVIEW_SENTRY_DSN",
        "EXPO_PUBLIC_API_BASE": "$PREVIEW_API_BASE",
        "EXPO_PUBLIC_ENTITLEMENT_PUBKEY": "$PREVIEW_ENTITLEMENT_PUBKEY"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_SENTRY_DSN": "$PRODUCTION_SENTRY_DSN",
        "EXPO_PUBLIC_API_BASE": "$PRODUCTION_API_BASE",
        "EXPO_PUBLIC_ENTITLEMENT_PUBKEY": "$PRODUCTION_ENTITLEMENT_PUBKEY"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "25T7H2DCB3"
      }
    }
  }
}
