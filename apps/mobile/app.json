{
  "expo": {
    "name": "Xangarro!",
    "slug": "xangarro",
    "scheme": "xangarro",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFD60A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mx.xangarro.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "mx.xangarro.mobile",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#111111"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-font",
      "expo-updates",
      "expo-secure-store",
      "./plugins/with-min-pod-deployment-target.js"
    ],
    "updates": {
      "url": "https://u.expo.dev/819fa99a-ea6b-44f8-ab3f-c3d168504967",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "819fa99a-ea6b-44f8-ab3f-c3d168504967"
      }
    },
    "owner": "z3r0makers-organization"
  }
}
