{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "paths": {
      "@xangarro/ui": ["../../packages/ui/src/index.ts"],
      "@xangarro/ui/*": ["../../packages/ui/src/*"],
      "@xangarro/domain": ["../../packages/domain/src/index.ts"],
      "@xangarro/application": ["../../packages/application/src/index.ts"],
      "@xangarro/data": ["../../packages/data/src/index.ts"],
      "@xangarro/observability": ["../../packages/observability/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app.json",
    "../../packages/ui/src/assets/images.d.ts"
  ],
  "exclude": ["node_modules", ".expo", ".turbo"]
}
