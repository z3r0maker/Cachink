{
  "name": "@xangarro/backoffice",
  "version": "0.0.0",
  "private": true,
  "description": "Xangarro! internal staff console at admin.xangarro.mx (ADR-063). Next.js App Router, vanilla-extract over @xangarro/tokens (ADR-057). The only project that may hold the Supabase service-role key.",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3200",
    "build": "NODE_ENV=production next build --webpack",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --config ../../eslint.config.js && tsx scripts/guard-service-role.ts",
    "lint:fix": "eslint . --config ../../eslint.config.js --fix",
    "staff": "tsx scripts/staff.ts",
    "clean": "rm -rf .next dist .turbo",
    "test:e2e": "DATABASE_URL=$(../../packages/data-pg/scripts/db-local.sh admin-url) DATABASE_SUPER_URL=$(../../packages/data-pg/scripts/db-local.sh super-url) playwright test",
    "test:e2e:db": "./scripts/e2e-db-setup.sh && pnpm test:e2e"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.21.2",
    "@xangarro/application": "workspace:*",
    "@xangarro/auth-core": "workspace:*",
    "@xangarro/data-pg": "workspace:*",
    "@xangarro/domain": "workspace:*",
    "@xangarro/email": "workspace:*",
    "@xangarro/tokens": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "uqr": "0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "@xangarro/config": "workspace:*",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "@playwright/test": "^1.63.0",
    "postgres": "^3.4.7"
  }
}
