# Xangarro admin console (admin.xangarro.mx) — every environment variable it reads.
#
# Copy to .env.local for local work (gitignored), or set each one in the admin
# Vercel project (Settings → Environment Variables). Values stay EMPTY here;
# never commit a real one. Runbook: docs/ops/provisioning.md.
# `scripts/env-example.test.ts` fails CI when this file and the code drift.
#
# No Supabase API key is used: the console connects as its own Postgres login
# role, provisioned by `pnpm --filter @xangarro/data-pg db:migrate:hosted`.

# --- Database -----------------------------------------------------------------
# Staff console: cross-tenant READ, staff tables. Role: xangarro_admin.
# Hosted: Transaction pooler, port 6543, user xangarro_admin.jijggmddzacwcldwnmzj, ?sslmode=require.
# (`pnpm staff` is the exception: run it with the postgres role's Session-pooler URL.)
DATABASE_URL=

# --- Staff sign-in ------------------------------------------------------------
# 32 bytes, base64; seals every TOTP seed. Rotating it forces every staff member to enrol again.
# Generate with: openssl rand -base64 32
ADMIN_TOTP_KEY=
# Public origin for links in alerts and the digest; default https://admin.xangarro.mx.
ADMIN_BASE_URL=

# --- Support inbox (portal → admin) -------------------------------------------
# Shared with the portal project's ADMIN_INGEST_SECRET; unset closes the endpoint.
# Generate with: openssl rand -base64 32
ADMIN_INGEST_SECRET=
# Optional webhook (Slack/Discord-compatible) for urgent support items.
ALERT_WEBHOOK_URL=

# --- Crons (vercel.json) ------------------------------------------------------
# Vercel sends it as `Authorization: Bearer …`; unset closes /api/cron/digest.
# Generate with: openssl rand -base64 32
CRON_SECRET=
# Staff digest recipient; default soporte@xangarro.mx.
DIGEST_TO=

# --- Email: Resend (B-14, docs/ops/email.md) ----------------------------------
# Sending-only key for xangarro.mx (one key per Vercel project).
RESEND_API_KEY=
# Optional; default `Xangarro <hola@xangarro.mx>`.
EMAIL_FROM=
# Optional, e.g. soporte@xangarro.mx.
EMAIL_REPLY_TO=
