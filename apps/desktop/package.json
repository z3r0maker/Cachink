{
  "name": "@cachink/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cachink desktop app (Windows and macOS) via Tauri 2. See ./SETUP.md.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:check": "cd src-tauri && cargo check --locked",
    "tauri:test": "cd src-tauri && cargo test --locked",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:lan": "playwright test --config=playwright.config.ts lan-",
    "test:cloud": "playwright test --config=playwright.config.ts cloud-",
    "lint": "eslint 'src/**/*.{ts,tsx}' --config ../../eslint.config.js --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules src-tauri/target"
  },
  "dependencies": {
    "@cachink/application": "workspace:*",
    "@cachink/data": "workspace:*",
    "@cachink/domain": "workspace:*",
    "@cachink/ui": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@journeyapps/wa-sqlite": "^1.7.0",
    "@powersync/common": "^1.53.1",
    "@powersync/web": "^1.38.1",
    "@supabase/supabase-js": "^2.105.4",
    "@tamagui/config": "2.0.0-rc.42",
    "@tamagui/core": "2.0.0-rc.42",
    "@tamagui/web": "2.0.0-rc.42",
    "@tanstack/react-query": "^5.100.10",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "dinero.js": "^2.0.2",
    "echarts": "~6.0.0",
    "echarts-for-react": "~3.0.6",
    "i18next": "^26.2.0",
    "lucide-react": "^1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.76.0",
    "react-i18next": "^17.0.8",
    "ulid": "^3.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}
