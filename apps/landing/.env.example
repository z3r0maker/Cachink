# Copy this file to .env and fill in your values before running `npm run build`.
# Never commit .env — it is already in .gitignore.

# ── Production domain ──────────────────────────────────────────────────────
# Full URL with no trailing slash. Used in canonical, OG, JSON-LD, robots.txt, sitemap.xml.
VITE_SITE_URL=https://xangarro.mx

# ── Analytics ──────────────────────────────────────────────────────────────
# Plausible domain (e.g. xangarro.mx). Leave empty to disable the snippet.
# Sign up at https://plausible.io — no cookies, no consent banner needed.
VITE_PLAUSIBLE_DOMAIN=

# Conteo por estado (N-58): la URL del pixel del portal, p. ej.
# https://app.xangarro.mx/api/geo/pixel
# Vacío = no se emite nada. Sin cookies, sin identificador, sin IP guardada;
# sólo un conteo diario por estado.
# NO ENCENDER hasta que el sitio publique su aviso de privacidad (ADR-092).
VITE_GEO_PIXEL_URL=
