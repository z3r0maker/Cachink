# Copy this file to .env and fill in your values before running `npm run build`.
# Never commit .env — it is already in .gitignore.

# ── Production domain ──────────────────────────────────────────────────────
# Full URL with no trailing slash. Used in canonical, OG, JSON-LD, robots.txt, sitemap.xml.
VITE_SITE_URL=https://cachink.mx

# ── Waitlist form endpoint ─────────────────────────────────────────────────
# POST endpoint that accepts { "email": "user@example.com" }.
# Options:
#   Resend route:     https://your-worker.your-subdomain.workers.dev/waitlist
#   Formspree:        https://formspree.io/f/YOUR_FORM_ID
#   ConvertKit:       https://api.convertkit.com/v3/forms/YOUR_FORM_ID/subscribe
# Leave empty in development — the form will show success without posting.
VITE_WAITLIST_ENDPOINT=

# ── Analytics ──────────────────────────────────────────────────────────────
# Plausible domain (e.g. cachink.mx). Leave empty to disable the snippet.
# Sign up at https://plausible.io — no cookies, no consent banner needed.
VITE_PLAUSIBLE_DOMAIN=
