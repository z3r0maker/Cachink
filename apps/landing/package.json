{
  "name": "@xangarro/landing",
  "version": "1.0.0",
  "private": true,
  "description": "Xangarro! marketing site (xangarro.mx): Vite + React, prerendered to static HTML (ADR-084).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/fonts.mjs && vite",
    "build": "node scripts/build.mjs && node scripts/prerender.mjs",
    "build:client": "node scripts/build.mjs",
    "preview": "vite preview --port 4173",
    "lint": "cd ../.. && eslint apps/landing --config eslint.config.js",
    "lint:fix": "cd ../.. && eslint apps/landing --config eslint.config.js --fix",
    "typecheck": "echo 'apps/landing is plain JS; its build (the test task) is its check (ADR-084)'",
    "test": "pnpm run build",
    "clean": "rm -rf dist .turbo",
    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xangarro/config": "workspace:*",
    "playwright": "^1.63.0",
    "sharp": "^0.34.5",
    "vite": "^5.4.8"
  }
}
