# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.turbo/
*.tsbuildinfo

# Test output
coverage/
*.log

# Environment
.env
.env.local
.env.*.local

# IDE / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Expo / React Native
.expo/
.expo-shared/
web-build/
ios/
android/
!apps/*/ios/
!apps/*/android/

# Tauri
target/
src-tauri/target/

# SQLite (dev)
*.sqlite
*.sqlite-journal
*.db

# Misc
*.pem
.rnstorybook/

# Storybook + Playwright build artifacts (baselines under __snapshots__/
# ARE tracked — those are the visual-regression source of truth).
packages/ui/storybook-static/
packages/ui/playwright-report/
packages/ui/test-results/

# Maestro E2E reports — generated data (viewer is checked in)
e2e-reports/runs/
e2e-reports/fold-tours/
e2e-reports/latest.json
e2e-reports/runs-index.js
apps/mobile/maestro/reports/

# Process manager state (auto-generated)
.pm-state/

# Python bytecode from maestro helper scripts
__pycache__/
*.pyc

# Next.js (apps/web)
.next/
next-env.d.ts
.vercel/

# Playwright storage state: a signed session cookie. Never commit it, and
# keep prettier out of it (format:check reads this file, not apps/web/.gitignore).
**/e2e/.auth/

# Dev email outbox (B-14): .eml/.html written when RESEND_API_KEY is unset
.email-outbox/

# design:compare output (P-21 writes to the repo root) — a local review, never committed.
# Root-anchored on purpose: the unanchored `design-compare/` also hid the harness
# sources under scripts/design-compare/, which is how the first harness was lost.
/design-compare/

# Loose debugging screenshots dropped at the repository root by Maestro and
# the Simulator. They are throwaway captures of a single run; the E2E artifacts
# that matter are written under `e2e-reports/` (ADR-100).
/maestro-*.png
/sim-screenshot*.png

# `pnpm audit:gate` writes this before scripts/audit-gate.ts reads it.
# (Arrived from N-26 attached to the design-compare block; given its own.)
.audit.json
