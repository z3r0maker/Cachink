{
  "name": "cachink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finanzas para emprendedores — simple POS and financial control for Mexican small businesses",
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "bundle:check": "turbo run bundle:check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "prepare": "husky",
    "release:build": "./scripts/build-all.sh",
    "release:dry-run": "./scripts/build-all.sh --dry-run",
    "store:screenshots": "tsx scripts/take-store-screenshots.ts",
    "deps:check": "taze -r",
    "deps:update": "taze -r --write --maturity-period 7d && pnpm install"
  },
  "devDependencies": {
    "@cachink/config": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "taze": "^19.12.0",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "typescript": "6.0.3"
      }
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
