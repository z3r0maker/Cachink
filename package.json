{
  "name": "cachink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finanzas para emprendedores — simple POS and financial control for Mexican small businesses",
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "bundle:check": "turbo run bundle:check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage --continue",
    "lint": "turbo run lint && pnpm lint:root",
    "lint:fix": "turbo run lint:fix && pnpm lint:root --fix",
    "lint:design": "tsx scripts/design-lint/index.ts",
    "lint:store": "tsx scripts/store-compliance/index.ts",
    "storybook:smoke": "tsx scripts/storybook-smoke.ts",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "typecheck": "turbo run typecheck && tsc -p supabase/functions/bug-report/tsconfig.json",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "prepare": "husky",
    "release:build": "./scripts/build-all.sh",
    "release:dry-run": "./scripts/build-all.sh --dry-run",
    "store:screenshots": "tsx scripts/take-store-screenshots.ts",
    "deps:check": "taze -r",
    "deps:update": "taze -r --write --maturity-period 7d && pnpm install",
    "e2e:report": "open e2e-reports/index.html",
    "mock:api": "pnpm --filter @xangarro/contracts mock:api",
    "design:contract": "tsx scripts/design-contract/index.ts",
    "lint:root": "eslint scripts supabase/functions '*.config.ts' --config eslint.config.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@xangarro/config": "workspace:*",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "taze": "^19.12.0",
    "tsx": "^4.23.13",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@xangarro/landing>react": "18.3.1",
      "@xangarro/landing>react-dom": "18.3.1",
      "react": "19.2.6",
      "react-dom": "19.2.6"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "typescript": "6.0.3"
      }
    },
    "onlyBuiltDependencies": [
      "@shopify/react-native-skia",
      "@swc/core",
      "better-sqlite3",
      "esbuild"
    ]
  }
}
