{
  "title": "Synth corrida",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d{8}-[0-9a-f]{4}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "single",
        "smoke",
        "full"
      ]
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "app_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "app_dirty": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "started_at",
    "mode",
    "repetitions",
    "app_commit",
    "app_dirty"
  ],
  "additionalProperties": false
}
