{
  "title": "Synth run",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+__[a-z0-9-]+__(?:task|walkthrough)__r[1-9]\\d*$"
    },
    "persona": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "scenario": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "style": {
      "type": "string",
      "enum": [
        "task",
        "walkthrough"
      ]
    },
    "repetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "runner": {
      "type": "string",
      "enum": [
        "web",
        "phone"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "abandoned",
        "blocked",
        "error"
      ]
    },
    "success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "thought": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "n",
          "thought",
          "action",
          "observed",
          "fingerprint"
        ],
        "additionalProperties": false
      }
    },
    "tokens": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "input",
        "output",
        "cache_read",
        "cache_write"
      ],
      "additionalProperties": false
    },
    "estimated_cost_usd_cents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "persona",
    "scenario",
    "style",
    "repetition",
    "runner",
    "outcome",
    "success",
    "steps",
    "tokens",
    "estimated_cost_usd_cents",
    "duration_ms",
    "started_at"
  ],
  "additionalProperties": false
}
