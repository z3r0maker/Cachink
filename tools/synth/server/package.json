{
  "name": "@xangarro/synth-server",
  "version": "0.0.0",
  "private": true,
  "description": "Synth's local server (ADR-153): runs corridas, indexes reports/ and serves Studio's API on 127.0.0.1 only.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint . --config ../../../eslint.config.js",
    "lint:fix": "eslint . --config ../../../eslint.config.js --fix",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@xangarro/config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
