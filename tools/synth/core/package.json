{
  "name": "@xangarro/synth-core",
  "version": "0.0.0",
  "private": true,
  "description": "Synth's harness logic (ADR-153): schemas, aggregation and reactions. Pure TS: no React, and no IO beyond what a script hands it.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx src/cli/validate.ts",
    "schemas": "tsx src/cli/schemas.ts",
    "lint": "eslint . --config ../../../eslint.config.js",
    "lint:fix": "eslint . --config ../../../eslint.config.js --fix",
    "clean": "rm -rf dist .turbo",
    "stack": "tsx src/cli/stack.ts",
    "test:stack": "SYNTH_STACK=1 vitest run .integration.test",
    "test:db": "SYNTH_DB=1 tsx src/cli/stack.ts run --no-server -- vitest run success.integration",
    "test:seeded": "SYNTH_SEEDED=1 tsx src/cli/stack.ts run -- vitest run seeded.integration",
    "setup": "pnpm install --dir ../vendor/playwright-mcp --ignore-workspace --frozen-lockfile",
    "run-one": "tsx src/cli/run-one.ts",
    "isolation": "tsx src/cli/isolation.ts",
    "judge": "tsx src/cli/judge.ts",
    "aggregate": "tsx src/cli/aggregate.ts",
    "corrida": "tsx src/cli/corrida.ts"
  },
  "dependencies": {
    "@xangarro/contracts": "workspace:*",
    "@xangarro/domain": "workspace:*",
    "@xangarro/testing": "workspace:*",
    "bcryptjs": "3.0.3",
    "playwright-core": "1.65.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@xangarro/config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
