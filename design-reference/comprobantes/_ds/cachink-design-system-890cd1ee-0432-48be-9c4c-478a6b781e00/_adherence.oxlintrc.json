{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "landing/**",
              "packages/ui/src/**",
              "packages/ui/src/components/BottomTabBar/**",
              "packages/ui/src/components/Btn/**",
              "packages/ui/src/components/Card/**",
              "packages/ui/src/components/EmptyState/**",
              "packages/ui/src/components/Gauge/**",
              "packages/ui/src/components/Input/**",
              "packages/ui/src/components/Kpi/**",
              "packages/ui/src/components/SectionTitle/**",
              "packages/ui/src/components/Tag/**",
              "packages/ui/src/components/TopBar/**",
              "tweaks-panel.jsx",
              "ui_kits/cachink_mobile/**",
              "ui_kits/cachink_mobile/components/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--bg",
      "--black",
      "--blue",
      "--blue-soft",
      "--border-thick",
      "--border-thin",
      "--fg-1",
      "--fg-2",
      "--fg-faint",
      "--fg-muted",
      "--font-sans",
      "--fw-black",
      "--fw-bold",
      "--fw-medium",
      "--fw-regular",
      "--fw-semi",
      "--fw-xbold",
      "--gray-100",
      "--gray-200",
      "--gray-400",
      "--gray-600",
      "--green",
      "--green-soft",
      "--ink",
      "--offwhite",
      "--press-duration",
      "--press-ease",
      "--press-shift",
      "--r-10",
      "--r-12",
      "--r-14",
      "--r-16",
      "--r-18",
      "--r-20",
      "--r-22",
      "--r-8",
      "--red",
      "--red-soft",
      "--shadow-card",
      "--shadow-hero",
      "--shadow-pressed",
      "--shadow-sm",
      "--surface",
      "--surface-hero",
      "--tracking-normal",
      "--tracking-tight",
      "--tracking-tighter",
      "--tracking-tightest",
      "--tracking-wide",
      "--tracking-wider",
      "--tracking-widest",
      "--warning",
      "--warning-soft",
      "--white",
